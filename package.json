{
  "name": "mcp-browser",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "MCP Browser — Electron app to manage MCP HTTP endpoints and browse tools (tools/list).",
  "author": "Guo's",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "//overrides.builder-util-runtime": "锁定 9.5.1：electron-builder / electron-updater 传递依赖里 builder-util-runtime 版本若不统一，可能出现构建或运行时异常。升级 electron-builder 后可先删掉 overrides 再 pnpm i && pnpm dist 验证；通过即可删除本 override。",
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "builder-util-runtime": "9.5.1"
    }
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "rebuild": "pnpm clean && pnpm dist",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:test": "vite build --mode=test",
    "dist": "pnpm run build && node scripts/gen-icon-ico.mjs && electron-builder --publish never",
    "dist:dir": "pnpm run build && node scripts/gen-icon-ico.mjs && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:update-screenshots": "node scripts/test-update-screenshots.mjs"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "i18next": "^26.0.3",
    "react-i18next": "^17.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "rcedit": "5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
