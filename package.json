{
  "name": "mcp-browser",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "MCP BROWSER — Electron app to manage MCP HTTP endpoints and browse tools (tools/list).",
  "author": "Guo's",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "rebuild": "pnpm clean && pnpm build",
    "build:dir": "tsc && vite build && electron-builder --dir --publish never",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:update-screenshots": "node scripts/test-update-screenshots.mjs"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "i18next": "^26.0.3",
    "react-i18next": "^17.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5"
  }
}
